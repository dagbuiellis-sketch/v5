# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM CONFIG
BOT_TOKEN="your_bot_token"
ADMIN_ID="your_user_id"
API_ID="your_api_id"
API_HASH="your_api_hash"

# PUBLIC CHANNELS (User usernames or IDs)
CH_MAIN="@VinehillMain"
CH_MOVIES="@VinehillMovies"
CH_SERIES="@VinehillSeries"
CH_ANIME="@VinehillAnime"
CH_GAMES="@VinehillGames"
CH_MUSIC="@VinehillMusic"

# STORAGE CHANNELS (Raw Staging Channels where you forward original un-renamed files)
STORAGE_MOVIES="-100..."
STORAGE_SERIES="-100..."
STORAGE_ANIME="-100..."
STORAGE_GAMES="-100..."
STORAGE_MUSIC="-100..."
BACKUP_CHANNEL="-100..."

# RENAMED DESTINATION CHANNELS (Where files are automatically uploaded after renaming & then announced)
RENAMED_MOVIES="@renamed_movies"
RENAMED_SERIES="@renamed_series"
RENAMED_ANIME="@renamed_anime"

# TMDB CONFIG
TMDB_API_KEY="your_tmdb_key"

# FIREBASE SECURITY & PERSISTENCE (Highly Recommended for Cloud Hosting like Render)
# Option A (Standard - Service Account): Copy the stringified JSON from Firebase Console Service Account key
FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'
# Option B (Fallback - Email/Password): Set the credential of the admin (ellisdagbui1@gmail.com) from Firebase Auth console
FIREBASE_ADMIN_EMAIL="ellisdagbui1@gmail.com"
FIREBASE_ADMIN_PASSWORD="your_admin_password"

